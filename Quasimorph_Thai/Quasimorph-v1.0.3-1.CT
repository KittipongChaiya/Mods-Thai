<CheatEntry>
<ID>138</ID>
<Description>"Faction Stats - also capture on Sell"</Description>
<Color>FF8000</Color>
<VariableType>Auto Assembler Script</VariableType>
<AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
return qmHook('hkSell', 'MGSC.TradeSystem:SellItems', 'mov [pFactions],rdx')

[DISABLE]
{$lua}
if syntaxcheck then return end
return qmUnhook('hkSell')

{Second capture point for the same pFactions symbol,
so selling populates the Faction Stats tree as well.}
</AssemblerScript>
</CheatEntry>
